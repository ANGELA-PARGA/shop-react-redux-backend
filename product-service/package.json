{
  "name": "product-service",
  "version": "1.0.0",
  "description": "Product Service for AWS Lambda with Serverless Framework",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "seed": "node scripts/seed-database.js",
    "deploy": "serverless deploy",
    "deploy:dev": "serverless deploy --stage dev",
    "deploy:prod": "serverless deploy --stage prod",
    "remove": "serverless remove",
    "logs:getProductsList": "serverless logs -f getProductsList",
    "logs:getProductsById": "serverless logs -f getProductsById"
  },
  "keywords": [
    "serverless",
    "lambda",
    "aws",
    "api-gateway",
    "products"
  ],
  "author": "Angela Parga",
  "license": "MIT",
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.978.0",
    "@aws-sdk/lib-dynamodb": "^3.978.0"
  }
}
